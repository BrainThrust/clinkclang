	async function handleStart() {
		return {
			status: 'Running',
			currentAction: 'Initializing',
			totalSteps: 4
		};
	}

	async function handleStop() {
		console.log('Stopped');
	}

	async function handleResume(currentAction: string) {
		return {
			status: 'Running',
			currentAction,
			totalSteps: 4
		};
	}

	async function handleProgress(step: number) {
		return {
			status: 'Running',
			currentAction: `Step ${step}`,
			progress: step + 1,
			totalSteps: 5
		};
	}
</script>

